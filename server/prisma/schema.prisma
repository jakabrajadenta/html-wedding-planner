generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChecklistItem {
  id        String    @id @default(uuid())
  title     String
  category  String?
  isDone    Boolean   @default(false)
  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("checklist_items")
}
